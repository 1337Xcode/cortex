# EditorConfig: https://editorconfig.org
# Prevents editors from inserting UTF-8 BOM and enforces consistent line endings.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 4

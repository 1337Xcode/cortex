# Local dev (optional; issues form needs deployed worker)
PUBLIC_ISSUES_API_URL=https://cortex-issues-api.<your-subdomain>.workers.dev
PUBLIC_TURNSTILE_SITE_KEY=

# Hero demo video (YouTube video ID only)
PUBLIC_DEMO_VIDEO_ID=

# Production: set the same names as GitHub repository secrets for the Deploy Site workflow.
# TURNSTILE_SITE is accepted as an alias for PUBLIC_TURNSTILE_SITE_KEY.

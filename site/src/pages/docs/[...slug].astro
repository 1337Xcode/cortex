---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import Sidebar from '../../components/layout/Sidebar.astro';
import TableOfContents from '../../components/docs/TableOfContents.tsx';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<DocLayout
  pageSeo={{ title: entry.data.title, description: entry.data.description }}
  slug={`docs/${entry.id}`}
  headings={headings}
>
  <Sidebar slot="sidebar" currentSlug={entry.id} />
  <Content />
  <TableOfContents client:load slot="toc" headings={headings} />
</DocLayout>

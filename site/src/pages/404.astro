---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/layout/PageShell.astro';
import { withBase } from '../lib/paths';
---
<BaseLayout pageSeo={{ title: 'Page Not Found', description: 'The page you are looking for does not exist.' }} slug="">
  <PageShell>
    <div class="mx-auto max-w-lg py-12 text-center">
      <p class="text-6xl font-bold text-muted-foreground/30 tabular-nums">404</p>
      <h1 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight text-foreground">Page not found</h1>
      <p class="mt-2 text-base sm:text-lg text-muted-foreground">The page you requested does not exist or has moved.</p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href={withBase('/')}
          class="inline-flex items-center justify-center rounded-md bg-accent text-text-inverse px-5 py-2.5 text-sm font-medium hover:bg-accent-hover transition-colors"
        >
          Back to home
        </a>
        <a
          href={withBase('/docs/getting-started/')}
          class="inline-flex items-center justify-center rounded-md border border-border px-5 py-2.5 text-sm font-medium text-foreground hover:bg-muted transition-colors"
        >
          Read the docs
        </a>
      </div>
    </div>
  </PageShell>
</BaseLayout>

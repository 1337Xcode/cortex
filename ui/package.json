{
  "name": "cortex-map-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Cortex map: a browser view of a repository and the links Cortex has learned.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "tsc --noEmit && tsc --noEmit -p e2e && eslint . && prettier --check . && vitest run",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@deck.gl/react": "9.4.1",
    "d3-hierarchy": "3.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}

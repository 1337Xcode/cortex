    "token_savings_baseline": {
      "description": "Baseline cost computed as: matching_file_count * average_file_tokens + grep_output_tokens. For the Cortex codebase (~80 source files, ~300 tokens avg per file), a typical grep query matches 5-15 files.",
      "estimated_avg_file_tokens": 300,
      "estimated_grep_output_tokens_per_match": 20,
      "estimated_baseline_per_query": 2500,
      "notes": "Token savings = baseline_cost - cortex_response_tokens. Cortex responses typically 200-800 tokens, yielding 1700-2300 tokens saved per query."
    }

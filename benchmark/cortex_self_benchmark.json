{
  "name": "cortex-self-benchmark",
  "description": "Comprehensive benchmark suite using the Cortex codebase itself as the repository snapshot. Contains 24 test cases with ground-truth answers for trace_callers, blast_radius, get_task_context, and ask queries. Validates correctness and measures token savings vs grep baseline.",

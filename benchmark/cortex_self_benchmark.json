    {
      "id": "trace-callers-dispatch-tool",
      "tool_name": "trace_callers",
      "input_args": {
        "fqn": "src/mcp/dispatch.rs::dispatch_tool",
        "depth": 2
      },
      "expected_output": {
        "expected_fqns": [
          "src/mcp/server.rs::McpServer::handle_tools_call",
          "src/benchmark/mod.rs::execute_case"
        ],
        "min_results": 1,
        "expected_keywords": ["dispatch_tool", "handle_tools_call"]
      },
      "tolerance": {
        "fqn_match_ratio": 0.5,
        "allow_extra_results": true
